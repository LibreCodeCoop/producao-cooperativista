{
    "name": "librecodecoop/producao-cooperativista",
    "description": "ETL de apuração e distribuição da produção cooperativista da LibreCode",
    "type": "project",
    "license": "AGPL-3.0-or-later",
    "require": {
        "php": "^8.5",
        "cmixin/business-day": "^1.20.6",
        "doctrine/doctrine-bundle": "^3.3.3",
        "doctrine/doctrine-migrations-bundle": "^4.0.1",
        "doctrine/orm": "^3.7.5",
        "librecodecoop/impostos": "^0.2.2",
        "scienta/doctrine-json-functions": "^6.4",
        "symfony/browser-kit": "^8.1.9",
        "symfony/css-selector": "^8.1.6",
        "symfony/dotenv": "^8.1.6",
        "symfony/framework-bundle": "^8.1.9",
        "symfony/http-client": "^8.1.9",
        "symfony/monolog-bundle": "^4.1.0",
        "symfony/runtime": "^8.1.9",
        "symfony/twig-bundle": "^8.1.9",
        "symfony/yaml": "^8.1.9",
        "twig/twig": "^3.30.0"
    },
    "require-dev": {
        "bamarni/composer-bin-plugin": "^1.9.1",
        "doctrine/data-fixtures": "^2.2.0",
        "symfony/maker-bundle": "^1.68.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/php/"
        }
    },
    "bin": [
        "bin/console"
    ],
    "config": {
        "allow-plugins": {
            "bamarni/composer-bin-plugin": true,
            "php-http/discovery": true,
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "bump-after-update": true,
        "optimize-autoloader": true,
        "classmap-authoritative": true,
        "sort-packages": true
    },
    "extra": {
        "bamarni-bin": {
            "bin-links": false,
            "target-directory": "vendor-bin",
            "forward-command": true
        },
        "symfony": {
            "allow-contrib": false,
            "require": "^8.0"
        }
    },
    "scripts": {
        "bin": "echo 'bin not installed'",
        "lint": "find bin config migrations public src tests -type f -name \\*.php -print0 | xargs -0 -r -n1 php -l",
        "cs:check": "PHP_CS_FIXER_IGNORE_ENV=1 vendor-bin/cs/vendor/friendsofphp/php-cs-fixer/php-cs-fixer fix --dry-run --diff",
        "cs:fix": "PHP_CS_FIXER_IGNORE_ENV=1 vendor-bin/cs/vendor/friendsofphp/php-cs-fixer/php-cs-fixer fix",
        "psalm": "vendor-bin/psalm/vendor/bin/psalm --no-cache --threads=$(nproc)",
        "psalm:update-baseline": "vendor-bin/psalm/vendor/bin/psalm --threads=$(nproc) --update-baseline --set-baseline=tests/psalm-baseline.xml",
        "post-install-cmd": [
            "@composer bin all install --ansi",
            "composer dump-autoload"
        ],
        "post-update-cmd": [
            "@composer bin all update --ansi",
            "composer dump-autoload"
        ],
        "test:unit": "vendor-bin/unit/vendor/bin/phpunit -c tests/php/phpunit.xml --color --no-coverage --fail-on-warning --fail-on-risky --fail-on-phpunit-notice --fail-on-phpunit-deprecation",
        "rector:check": "vendor-bin/rector/vendor/bin/rector process --dry-run --no-progress-bar",
        "rector:fix": "vendor-bin/rector/vendor/bin/rector process --no-progress-bar"
    },
    "conflict": {
        "symfony/symfony": "*"
    }
}
