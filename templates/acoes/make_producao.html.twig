{% extends "layout/index.html.twig" %}

{% block title %}Processar produção cooperativista{% endblock %}

{% block head %}
    <script src="/js/production-progress.js" defer></script>
    <style>
        .alert { padding: 12px; margin: 12px 0; background: #fee4e2; border-radius: 4px; }
        .alert.info { background: #e2efff; }
        .alert.warning { background: #fff0cc; }
        .alert.success { background: #d7f5e5; }
        .notice { max-width: 52rem; }
    </style>
{% endblock %}

{% block body %}
    <p class="notice">A produção usa receitas e custos elegíveis da competência, não o saldo bancário da cooperativa. Confira a prévia antes de emitir documentos.</p>

    <form id="form-gera-producao" method="post" action="{{ url }}">
        <input type="hidden" name="_token" value="{{ token }}">
        <fieldset>
            <legend>Produção realizada em</legend>
            <label for="year">Ano</label>
            <select id="year" name="year">
                {% for j in range('now'|date('Y') - 1, 'now'|date('Y') + 1) %}
                    <option value="{{ j }}"{% if inicio_ano == j %} selected{% endif %}>{{ j }}</option>
                {% endfor %}
            </select>
            <label for="month">Mês</label>
            <select id="month" name="month">
                {% for j in 1..12 %}
                    <option value="{{ '%02d'|format(j) }}"{% if inicio_mes == '%02d'|format(j) %} selected{% endif %}>{{ '%02d'|format(j) }}</option>
                {% endfor %}
            </select>
        </fieldset>

        <fieldset>
            <legend>Baixar dados de fontes externas</legend>
            <label><input type="radio" name="baixar_dados" value="0"{% if baixar_dados == 0 %} checked{% endif %}> Não</label>
            <label><input type="radio" name="baixar_dados" value="1"{% if baixar_dados == 1 %} checked{% endif %}> Sim</label>
        </fieldset>

        <fieldset>
            <legend>Gravar produção no Akaunting</legend>
            <label><input type="radio" name="atualiza_producao" value="0"{% if atualiza_producao == 0 %} checked{% endif %}> Não (prévia)</label>
            <label><input type="radio" name="atualiza_producao" value="1"{% if atualiza_producao == 1 %} checked{% endif %}> Sim (gera/atualiza documentos)</label>
        </fieldset>

        <p class="notice">Em produção, a importação ou a gravação exige uma senha administrativa definida em <code>PRODUCAO_ACTION_TOKEN</code> no servidor.</p>
        <label for="action_token">Senha para operações de escrita</label>
        <input type="password" id="action_token" name="action_token" autocomplete="off" placeholder="Obrigatória para escrita em produção">
        <p><button type="submit" id="submit">Executar</button></p>
    </form>
    <div id="messages" role="status" aria-live="polite"></div>
{% endblock %}
