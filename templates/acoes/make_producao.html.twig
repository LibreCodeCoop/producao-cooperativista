{% extends "layout/index.html.twig" %}
{% block title %}Fechamento da produção cooperativista{% endblock %}
{% block head %}
    <link rel="stylesheet" href="/css/production-workflow.css{% if workflow_asset_version is defined %}?v={{ workflow_asset_version }}{% endif %}">
    <script src="/js/production-progress.js" defer></script>
    <script src="/js/production-workflow.js{% if workflow_asset_version is defined %}?v={{ workflow_asset_version }}{% endif %}" defer></script>
{% endblock %}
{% block body %}
    <nav class="breadcrumbs" aria-label="Localização">
        <a href="/acoes/make-producao">Fechamento</a><span aria-hidden="true">/</span><span aria-current="page">Fechamento mensal</span>
    </nav>
    <header class="page-heading">
        <p class="eyebrow">Produção cooperativista · Fechamento mensal</p>
        <h1>Fechar a produção</h1>
        <p class="page-lead">Importe a competência e confira os apontamentos por cooperado na tabela. Quando os dados estiverem revisados, calcule os valores para decidir sobre uma futura publicação no Akaunting.</p>
    </header>

    <nav class="production-steps" aria-label="Etapas do fechamento">
        <button type="button" data-step-indicator="1" aria-current="step"><b>1</b> Importar dados</button>
        <button type="button" data-step-indicator="2" disabled title="Disponível após consultar os dados importados"><b>2</b> Conferir e calcular</button>
    </nav>

    <div class="production-wizard surface" id="production-wizard" data-preview-url="/api/v1/producao" data-sources-url="/api/v1/producao/fontes">
        {# Separate the publication form from the read-only review table. #}
        <form id="form-gera-producao" data-workflow="yes" method="post" action="{{ url }}">
            <input type="hidden" name="_token" value="{{ token }}">
            <input type="hidden" name="year" value="{{ inicio_ano }}">
            <input type="hidden" name="month" value="{{ inicio_mes }}">
            <input type="hidden" name="baixar_dados" value="1">
            <input type="hidden" name="atualiza_producao" value="0">
            <input type="hidden" name="operation" value="import">
            <input type="hidden" name="expected_revision" value="">
            <input type="hidden" name="omit_user_ids" value="">
        </form>

        <section data-workflow-step="1" aria-labelledby="import-title">
            <p class="section-kicker">Etapa 1 de 2</p>
            <h2 id="import-title">Importar dados</h2>
            <p>Defina a competência das horas trabalhadas. Na configuração atual, a apuração é feita dois meses após o trabalho. A importação atualiza apenas os dados intermediários do ETL.</p>
            {% if imported_competence|default(null) and imported_competence != inicio_ano ~ '-' ~ inicio_mes %}
                <div class="information-note">
                    <strong>Última competência importada: {{ imported_competence }}</strong>
                    <p><a href="/acoes/make-producao?ano-mes={{ imported_competence }}">Conferir essa competência</a>.
                        Selecionar outro mês não apaga os dados já importados.</p>
                </div>
            {% endif %}
            <div class="production-period-fields">
                <div class="form-field">
                    <label for="month">Mês</label>
                    <select id="month">
                        {% for label in ['Janeiro','Fevereiro','Março','Abril','Maio','Junho','Julho','Agosto','Setembro','Outubro','Novembro','Dezembro'] %}
                            {% set number = '%02d'|format(loop.index) %}
                            <option value="{{ number }}"{% if inicio_mes == number %} selected{% endif %}>{{ label }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div class="form-field">
                    <label for="year">Ano</label>
                    <select id="year">
                        {% for j in range('now'|date('Y') - 2, 'now'|date('Y') + 1) %}
                            <option value="{{ j }}"{% if inicio_ano == j %} selected{% endif %}>{{ j }}</option>
                        {% endfor %}
                    </select>
                </div>
            </div>
            <div class="production-wizard-actions">
                <button type="button" id="import-button" class="button button-primary">Importar competência</button>
                <button type="button" id="use-existing" class="button">Conferir dados já importados</button>
                <a class="button button-secondary production-reset-link" href="/acoes/zerar-banco-local?retorno={{ (inicio_ano ~ '-' ~ inicio_mes)|url_encode }}">
                    Limpar base importada
                </a>
            </div>
            <div class="production-job-status" id="import-status" role="status" aria-live="polite" hidden>
                <span class="production-job-indicator" aria-hidden="true"></span>
                <span id="import-status-text"></span>
                <span id="import-elapsed" class="production-job-elapsed" aria-hidden="true"></span>
                <a id="import-profile-link" href="/configuracao/cooperados" hidden>
                    Corrigir cadastro em Configuração → Cooperados e vínculos
                </a>
            </div>
            <p class="production-help">A limpeza remove todos os dados intermediários importados, não apenas esta competência, e exige confirmação na próxima página. Ela não modifica os sistemas de origem nem os documentos já emitidos.</p>
        </section>

        <section data-workflow-step="2" hidden aria-labelledby="audit-title">
            <p class="section-kicker">Etapa 2 de 2 · <span id="review-competence"></span></p>
            <h2 id="audit-title">Conferir produção por cooperado</h2>
            <p id="calculated-review-intro">Ordene e filtre a produção por cooperado. Abra os detalhes para conferir cada cliente. Clique no nome para editar o cadastro nas fontes; qualquer alteração exige nova importação. O peso exibido é o da importação. Todos serão publicados, exceto quem tiver a opção <strong>Não publicar agora</strong> marcada.</p>
            <div id="imported-data-review" class="information-note" hidden>
                <h3>Dados importados para conferência</h3>
                <p>Confira cooperados, horas, pesos e clientes na <strong>tabela abaixo</strong>, usando os mesmos filtros e a opção Detalhes. A composição financeira também estará visível, com <strong>A apurar</strong> nos valores ainda não calculados.</p>
                <p>Marque <strong>Não publicar agora</strong> para excluir um cooperado dos documentos quando houver uma prévia financeira válida. A seleção não publica nem faz pagamentos.</p>
                <p id="source-financial-status" role="status" hidden></p>
                <p><a id="pending-invoices-link" href="#" target="_blank" rel="noopener" hidden>Conferir documentos que exigem conciliação no Akaunting</a></p>
                <div class="production-wizard-actions">
                    <button type="button" id="calculate-financial-preview" class="button button-secondary">Calcular valores para publicação</button>
                </div>
                <details id="source-transaction-details">
                    <summary>Resumo técnico das fontes importadas (faturamento e despesas)</summary>
                    <pre id="imported-data-summary" class="production-source-summary" aria-live="polite"></pre>
                </details>
            </div>
            <div id="calculated-review">
            <div class="production-metrics" role="status" aria-live="polite">
                <div><span>Cooperados</span><strong id="metric-members">—</strong></div>
                <div><span>Horas</span><strong id="metric-hours">—</strong></div>
                <div><span>Base da produção</span><strong id="metric-base">—</strong></div>
                <div><span>Líquido previsto</span><strong id="metric-net">—</strong></div>
            </div>
            <p class="production-help" id="withdrawal-goal" role="status" aria-live="polite" hidden></p>
            <div class="production-table-intro">
                <div>
                    <strong>Produção por cooperado</strong>
                    <small>As escolhas são mantidas mesmo ao filtrar, ordenar ou mudar de página. Use Detalhes para consultar clientes e deduções.</small>
                </div>
            </div>
            {{ include('layout/components/datatable.html.twig', {
                url: '/api/v1/producao?ano-mes=' ~ inicio_ano ~ '-' ~ inicio_mes,
                filterColumns: ['metadata', 'kimai_user_id', 'hours_seconds'],
                productionMode: true,
                financialReview: true,
                manualInit: true,
                competencia: inicio_ano ~ '-' ~ inicio_mes
            }) }}
            <div class="production-selection-summary" id="selection-summary" aria-live="polite"></div>
            <p class="production-help">Não publicar agora não redistribui valores, não transfere horas para outro mês e não cancela documentos já existentes no Akaunting.</p>
            </div>

            <nav class="production-review-links" aria-label="Conferência complementar">
                <a data-report-path="/relatorios/calculos" href="/relatorios/calculos?ano-mes={{ inicio_ano }}-{{ inicio_mes }}" target="_blank" rel="noopener">
                    <strong>Memória de cálculo</strong><small>Fórmulas, rateio e bases financeiras</small>
                </a>
                <a data-report-path="/relatorios/invoices" href="/relatorios/invoices?ano-mes={{ inicio_ano }}-{{ inicio_mes }}" target="_blank" rel="noopener">
                    <strong>Entradas e saídas</strong><small>Documentos e classificações de origem</small>
                </a>
                <a href="/relatorios/categorias" target="_blank" rel="noopener">
                    <strong>Categorias financeiras</strong><small>Conferir lançamentos classificados</small>
                </a>
                <a data-report-path="/relatorios/producao" href="/relatorios/producao?ano-mes={{ inicio_ano }}-{{ inicio_mes }}" target="_blank" rel="noopener">
                    <strong>Abrir relatório separado</strong><small>Mesmos dados e filtros para consulta isolada</small>
                </a>
            </nav>

            <div class="production-final" id="production-publication-controls">
                <strong>Publicação no Akaunting</strong>
                <p id="publication-summary">Nenhuma publicação executada. Confira os valores e a seleção.</p>
                <label class="production-confirm-label">
                    <input type="checkbox" id="publication-confirmation">
                    Conferi a apuração e as exceções; autorizo a publicação dos documentos da competência.
                </label>
                <div class="production-wizard-actions">
                    <button type="button" id="submit" class="button button-primary" disabled>Publicar documentos no Akaunting</button>
                </div>
            </div>
        </section>
        <div id="messages" class="production-messages" role="status" aria-live="polite" aria-atomic="false"></div>
    </div>
{% endblock %}
