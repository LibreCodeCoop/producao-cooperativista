<div class="member-identity-inspection" data-identity-preview="{{ source }}">
    <div class="member-identity-inspection-heading">
        <strong>{{ title }}</strong>
        <button type="button" class="button member-identity-refresh" data-identity-verify="{{ source }}">Conferir</button>
    </div>
    <div class="member-identity-result" data-identity-result="{{ source }}" role="status" aria-live="polite">
        Dados ainda não consultados.
    </div>
</div>
