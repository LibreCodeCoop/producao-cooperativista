<section class="member-editor-panel" data-member-editor-panel>
    {% set link = links|default({}) %}
    {% set can_manage = can_manage|default(false) %}
    <header class="member-editor-heading">
        <p class="section-kicker">Cadastro · {{ month }}</p>
        <h2 id="member-editor-title">{{ member.alias }}</h2>
        <span class="member-editor-status{{ link.linked|default(false) ? ' is-ready' : ' is-warning' }}">
            {{ link.linked|default(false) ? 'Vínculos registrados' : 'Vínculo pendente' }}
        </span>
    </header>

    <section class="member-fields-main">
        <h3>Dados do cooperado</h3>
        {% if services.nextcloud.error %}
            <p class="member-editor-source-error" role="note">{{ services.nextcloud.error }}</p>
        {% endif %}
        {% for item in services.nextcloud.fields %}
            {% if can_manage %}
                {{ include('configuracao/_member_field.html.twig', {source:'nextcloud', item:item}) }}
            {% elseif item.field != 'tax_number' %}
                <p class="member-editor-description"><strong>{{ item.label }}:</strong> {{ item.value is not empty ? item.value : 'Não informado' }}</p>
            {% endif %}
        {% endfor %}
    </section>

    {% if can_manage %}
        <details class="member-editor-advanced member-editor-admin-links">
            <summary>Vínculos entre sistemas</summary>
            <p class="member-editor-description">Identificadores técnicos restritos à administração, gravados no Nextcloud Profile Fields.</p>
            <form method="post" class="member-link-form" action="/configuracao/cooperado/{{ member.id }}/vincular" autocomplete="off">
                <input type="hidden" name="_token" value="{{ token }}">
                <p class="member-editor-description">Confirme os identificadores associados a esta conta. Alterar o Kimai transfere este vínculo para outro usuário após conferir que não há duplicidade.</p>
                <div class="member-link-fields">
                    <div>
                        <label for="member-kimai-{{ member.id }}">Usuário Kimai (ID)</label>
                        <input id="member-kimai-{{ member.id }}" type="number" name="kimai_user_id"
                               value="{{ link.kimai_id|default(member.id) }}" min="1" step="1" required>
                    </div>
                    <div>
                        <label for="member-uid-{{ member.id }}">Conta Nextcloud</label>
                        <input id="member-uid-{{ member.id }}" type="search" name="nextcloud_uid"
                               value="{{ link.uid|default('') }}" data-link-source="nextcloud"
                               list="nc-users-{{ member.id }}" placeholder="Buscar usuário Nextcloud" required>
                        <datalist id="nc-users-{{ member.id }}"></datalist>
                    </div>
                    <div>
                        <label for="member-contact-{{ member.id }}">Contato Akaunting</label>
                        <input id="member-contact-{{ member.id }}" type="search" name="akaunting_contact_id"
                               value="{{ link.contact_id|default('') }}" data-link-source="akaunting"
                               list="akaunting-contacts-{{ member.id }}" inputmode="numeric"
                               pattern="[1-9][0-9]*" placeholder="Buscar contato" required>
                        <datalist id="akaunting-contacts-{{ member.id }}"></datalist>
                        {% if link.kimai_linked|default(false) and link.contact_id|default('') is empty %}
                            <div class="member-contact-provision" data-contact-provision>
                                <button type="button" class="member-contact-trigger" data-contact-provision-open>
                                    Não encontrou? Criar contato
                                </button>
                                <div class="member-contact-provision-panel" data-contact-provision-panel hidden>
                                    <p data-contact-provision-status role="status" aria-live="polite"></p>
                                    <div data-contact-provision-existing hidden></div>
                                    <div data-contact-provision-new hidden>
                                        <label for="member-new-contact-name-{{ member.id }}">Nome no Akaunting</label>
                                        <input id="member-new-contact-name-{{ member.id }}" type="text"
                                               data-contact-provision-name autocomplete="off" maxlength="120"
                                               value="{{ member.alias }}">
                                        <label class="member-contact-confirmation">
                                            <input type="checkbox" data-contact-provision-confirm>
                                            Conferi a identidade do cooperado
                                        </label>
                                        <button type="button" class="button button-secondary"
                                                data-contact-provision-create disabled>Criar contato</button>
                                    </div>
                                </div>
                            </div>
                        {% endif %}
                    </div>
                </div>
                <div class="member-link-actions">
                    <button type="submit" class="button button-primary">Salvar vínculos</button>
                    {% if not link.linked|default(false) %}
                        <button type="button" class="member-link-prepare button button-secondary" data-links-prepare>Preparar campos</button>
                    {% endif %}
                </div>
            </form>
        </details>
    {% endif %}
</section>
