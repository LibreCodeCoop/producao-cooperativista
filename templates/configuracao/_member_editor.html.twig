<section class="member-editor-panel" data-member-editor-panel>
    {% set link = links|default({}) %}
    <header class="member-editor-heading">
        <p class="section-kicker">Cadastro e vínculos · {{ month }}</p>
        <h2 id="member-editor-title">{{ member.alias }}</h2>
        <p>Usuário de horas: {{ member.username }} · ID {{ member.id }}</p>
    </header>
    <section class="member-link-panel" aria-label="Vincular sistemas">
        <div class="member-link-title">
            <h3>Vínculos entre sistemas</h3>
            <span class="member-editor-status{{ link.linked|default(false) ? ' is-ready' : ' is-warning' }}">
                {{ link.linked|default(false) ? 'Vinculado' : 'A confirmar' }}
            </span>
        </div>
        <form method="post" class="member-link-form" action="/configuracao/cooperado/{{ member.id }}/vincular" autocomplete="off">
            <input type="hidden" name="_token" value="{{ token }}">
            <p class="member-link-origin">Kimai #{{ member.id }} · {{ member.username }}</p>
            <div class="member-link-fields">
                <div>
                    <label for="member-uid-{{ member.id }}">Conta Nextcloud</label>
                    <input id="member-uid-{{ member.id }}" type="search" name="nextcloud_uid"
                        value="{{ link.uid|default('') }}" data-link-source="nextcloud"
                        list="nc-users-{{ member.id }}" placeholder="Buscar usuário Nextcloud" required>
                    <datalist id="nc-users-{{ member.id }}"></datalist>
                </div>
                <div>
                    <label for="member-contact-{{ member.id }}">Contato Akaunting</label>
                    <input id="member-contact-{{ member.id }}" type="search" name="akaunting_contact_id"
                        value="{{ link.contact_id|default('') }}" data-link-source="akaunting"
                        list="akaunting-contacts-{{ member.id }}" inputmode="numeric"
                        pattern="[1-9][0-9]*" placeholder="Buscar nome ou ID" required>
                    <datalist id="akaunting-contacts-{{ member.id }}"></datalist>
                </div>
            </div>
            <div class="member-link-actions">
                <button type="submit" class="button button-primary">Salvar vínculos</button>
                {% if not link.linked|default(false) %}
                    <button type="button" class="member-link-prepare button button-secondary" data-links-prepare>Preparar campos no Nextcloud</button>
                {% endif %}
            </div>
        </form>
        <p class="member-editor-description">Pesquise e selecione as contas; os vínculos são gravados no Profile Fields. O CPF/CNPJ permanece apenas como dado fiscal.</p>
    </section>
    <section class="member-fields-main">
        <h3>Peso e dependentes</h3>
        {% if services.nextcloud.error %}
            <p class="member-editor-source-error" role="note">{{ services.nextcloud.error }}</p>
        {% endif %}
        {% for item in services.nextcloud.fields %}
            {% if item.field != 'tax_number' %}
                {{ include('configuracao/_member_field.html.twig', {source:'nextcloud', item:item}) }}
            {% endif %}
        {% endfor %}
    </section>
    <details class="member-editor-advanced">
        <summary>Dados fiscais nas três fontes</summary>
        <p class="member-editor-description">Edite apenas valores incorretos. Salve em cada origem e reimporte antes de publicar.</p>
        <div class="member-editor-sources">
            {% for source, service in services %}
                <section class="member-editor-source">
                    <h3>{{ service.title }}</h3>
                    {% if service.error %}<p class="member-editor-source-error" role="note">{{ service.error }}</p>{% endif %}
                    {% for item in service.fields %}
                        {% if item.field == 'tax_number' %}
                            {{ include('configuracao/_member_field.html.twig', {source:source, item:item}) }}
                        {% endif %}
                    {% endfor %}
                </section>
            {% endfor %}
        </div>
    </details>
</section>
