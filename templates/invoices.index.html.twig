{% extends "layout/index.html.twig" %}
{% block title %}Entradas e saídas{% endblock %}
{% block head %}
    <link rel="stylesheet" href="/css/production-workflow.css">
{% endblock %}
{% block body %}
    <nav class="breadcrumbs" aria-label="Localização">
        <a href="/">Visão geral</a><span aria-hidden="true">/</span><span aria-current="page">Entradas e saídas</span>
    </nav>
    <header class="page-heading page-heading-compact">
        <p class="eyebrow">Conferência financeira · Competência</p>
        <h1>Entradas e saídas</h1>
        <p class="page-lead">Confira os lançamentos e volte à memória de cálculo para verificar sua participação na apuração.</p>
    </header>
    <div class="production-report-tools">
        <form method="get" action="/relatorios/invoices" class="production-month-picker">
            <label for="invoices-competence">Competência do trabalho</label>
            <input type="month" id="invoices-competence" name="ano-mes" value="{{ competencia }}" required>
            <button type="submit" class="button button-primary">Consultar</button>
        </form>
        <nav aria-label="Outras conferências" class="production-report-nav">
            <a href="/relatorios/calculos?ano-mes={{ competencia }}">Memória de cálculo</a>
            <a href="/relatorios/producao?ano-mes={{ competencia }}">Produção por cooperado</a>
            <a href="/acoes/make-producao?ano-mes={{ competencia }}">Voltar ao processamento</a>
        </nav>
    </div>
    {{ include('layout/components/datatable.html.twig') }}
{% endblock %}
