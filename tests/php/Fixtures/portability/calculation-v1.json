      "input": {
        "incomes": [
          {
            "customer_reference": "client-a",
            "base_producao": 9000,
            "percentual_desconto_fixo": false
          }
        ],
        "work": [
          {
            "customer_reference": "client-a",
            "tax_number": "member-a",
            "trabalhado": 3600,
            "peso": 2,
            "total_cliente": 18000
          },
          {
            "customer_reference": "client-a",
            "tax_number": "member-b",
            "trabalhado": 7200,
            "peso": 1,
            "total_cliente": 18000
          }
        ]
      },
      "expected": {
        "amounts_cents": {
          "member-a": 270000,
          "member-b": 270000
        },
        "fixed_eligible_cents": 0,
        "variable_eligible_cents": 900000,
        "variable_allocated_cents": 540000
      }
    },
